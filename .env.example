# Select either demo or production at deployment time. Never expose a UI switch.
NEXT_PUBLIC_SCHOOLTWIN_MODE=demo

# Safe browser values. Use the current Supabase publishable-key format.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_PROJECT_ID=
NEXT_PUBLIC_SUPABASE_FUNCTION_REGION=ap-south-1

# Server and Edge Function secrets. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
ACCESS_GRANT_PEPPER=
DEVICE_TOKEN_PEPPER=
WORK_LEASE_SECRET=
INTERNAL_CRON_SECRET=

# Optional destructive staging-only integration test fixture. The access pass
# is consumed by pnpm test:integration and must never point at production.
SCHOOLTWIN_LIVE_SUPABASE_URL=
SCHOOLTWIN_LIVE_SUPABASE_PUBLISHABLE_KEY=
SCHOOLTWIN_LIVE_REDEMPTION_SESSION_ID=
SCHOOLTWIN_LIVE_REDEMPTION_DEVICE_ID=
SCHOOLTWIN_LIVE_REDEMPTION_CODE=

# Isolated restoration gate. Never point these values at the live project.
RESTORE_SUPABASE_URL=
RESTORE_SUPABASE_SECRET_KEY=
RESTORE_REPORT_SECRET=
RESTORE_RECOVERY_POINT=
RESTORE_REVOCATIONS_FILE=
RESTORE_NETWORK_ISOLATED=false
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=ap-south-1
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
