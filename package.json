{
  "name": "schooltwin",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:backend": "vitest run --dir tests/backend",
    "test:integration": "vitest run --dir tests/backend-integration",
    "test:db": "supabase test db",
    "backend:start": "supabase start",
    "backend:stop": "supabase stop",
    "backend:reset": "supabase db reset",
    "backend:status": "supabase status",
    "backend:types": "supabase gen types typescript --local --schema public,private,officials > lib/schooltwin/backend/database.types.ts",
    "backend:restore-gate": "node scripts/restore-gate.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.57.0",
    "@vercel/analytics": "1.6.1",
    "@zxing/browser": "0.1.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "idb": "^8.0.3",
    "lucide-react": "^1.16.0",
    "next": "16.3.0",
    "react": "^19",
    "react-dom": "^19",
    "shadcn": "^4.8.0",
    "tailwind-merge": "^3.3.1",
    "tus-js-client": "^4.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "^6.2.4",
    "jsdom": "^27.4.0",
    "postcss": "^8.5",
    "prettier": "^3.9.0",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "supabase": "^2.45.5",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3",
    "vitest": "^4.1.0"
  }
}
